# Copy this file and set variables in your shell before running Streamlit.
#
# PowerShell:
#   $env:TOMTOM_API_KEY = "your_key_here"
#   streamlit run app/Home.py
#
# CMD:
#   set TOMTOM_API_KEY=your_key_here
#   streamlit run app/Home.py

# TomTom Traffic Flow API (free 2,500 req/day)
# Register: https://developer.tomtom.com/user/register
TOMTOM_API_KEY=

# Weather uses Open-Meteo (https://open-meteo.com) — no key needed.
